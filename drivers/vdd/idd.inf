;
; A virtual display: a user-mode indirect display driver (docs/11-drivers.md).
;
; The driver's build writes this file out with its brand's names in place of
; the placeholders (section 1.10); scripts/package-vdd.sh stamps the driver's
; version and the framework's into it, catalogues the package and signs it.
;

[Version]
PnpLockdown=1
Signature="$Windows NT$"
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Class=Display
ClassVer=2.0
Provider=%ManufacturerName%
CatalogFile=@CATALOG@
DriverVer=01/01/2026,0.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0...18362

; Windows 10 1903 on: the first release whose display class names the GPU to
; render on.
[Standard.NTamd64.10.0...18362]
%DeviceName%=Vdd_Install, @HARDWARE_ID@

[SourceDisksFiles]
@LIBRARY@=1

[SourceDisksNames]
1=%DiskName%

[DestinationDirs]
Vdd_Files=12,UMDF

; Copied aside when the old one is in use, so an update needs no restart.
[Vdd_Files]
@LIBRARY@,,,0x00004000

[Vdd_Install.NT]
CopyFiles=Vdd_Files

[Vdd_Install.NT.hw]
AddReg=Vdd_Hardware

; The indirect display class's kernel half above the device; a host process
; group of the driver's own; and the device's access: the system account and
; administrators fully, any interactive user to read and write -- the control
; interface.
[Vdd_Hardware]
HKR,,"UpperFilters",%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",%REG_SZ%,"@GROUP@"
HKR,,"Security",,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

; The reflector, in the form Windows 10 accepts.
[Vdd_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRD_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

; A host process of its own, never shared with another driver, so the process
; the host takes handles from holds this driver alone.
[Vdd_Install.NT.Wdf]
UmdfService=@SERVICE@,Vdd_Umdf
UmdfServiceOrder=@SERVICE@
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfHostProcessSharing=ProcessSharingDisabled

[Vdd_Umdf]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary=%12%\UMDF\@LIBRARY@
UmdfExtensions=IddCx0102

[Strings]
ManufacturerName="@PROVIDER@"
DiskName="@DEVICE@"
WudfRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DeviceName="@DEVICE@"
REG_MULTI_SZ=0x00010000
REG_SZ=0x00000000

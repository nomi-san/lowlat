# The raw node of a DualShock 4 or a DualSense a lowlat host presents for a
# guest's pad (docs/07-platforms.md section 4.2). The kernel's driver exposes
# the buttons, the touchpad and the motion sensors as input devices; the
# lights and the trigger effects are reached through the raw node, so the
# seat's user is granted it as the common game launcher's own rule grants
# the real pad's. Keyed on the device's identity, which the virtual pad
# shares with the real one, so the real one is granted the same.
KERNEL=="hidraw*", KERNELS=="*054C:05C4*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:09CC*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"

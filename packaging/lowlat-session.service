# A user unit: starts with a graphical session and ends with it.
[Unit]
Description=lowlat session helper
# Everything this speaks for -- the compositor's layout and modes, the screen
# saver, the clipboard -- exists only inside a graphical session and goes
# away with it, so this is part of the session rather than started by it.
PartOf=graphical-session.target
# **After the target is reached, not as part of reaching it.** The compositor
# socket and the session bus are imported into the user manager as the
# desktop brings its session up, and its own services -- the clipboard's
# among them -- start with it; a unit started alongside that sees neither.
# Measured: started two seconds before the target was reached, with no
# compositor socket in its environment.
After=graphical-session.target

[Service]
ExecStart=/usr/bin/lowlatd session
# The helper never exits on its own: with no service to reach it waits, and
# when the service restarts it reconnects. Its one deliberate exit is being
# replaced by a newer helper for the same session, which is not a failure.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

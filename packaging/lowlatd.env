# Where signaling is, and which session this host advertises as. Both are
# required and the service will not start without them. The session is a
# token the service hands out at login, and logging in is a person's job (it
# may need a second factor): `sudo lowlat-login --install` obtains one and
# writes it here (scripts/kessel-login.py in a checkout). It stays valid while the daemon holds its signaling
# connection, which it does; a machine off for a week logs in again.
KESSEL_WS_SERVER=
KESSEL_SESSION=

# The flags the daemon is started with, split on whitespace. For example:
# LOWLATD_ARGS=--output card0:HDMI-A-1 --clipboard send
# The display is captured unless --synth asks for the generator instead.
LOWLATD_ARGS=

# **The desktop's sound server, which a service outside the session has to be
# told the location of.** Its socket lives in that session's own runtime
# directory, and with nothing here the daemon looks where its own environment
# points, which is nowhere. A machine with no sound server simply reports that
# it has none.
# PULSE_SERVER=unix:/run/user/1000/pulse/native

# Reflexive servers, if the built-in pair are not the ones to use.
# LOWLAT_STUN=stun.l.google.com:19302,stun.cloudflare.com:3478

# **The login screen is captured only where the greeter presents through the
# display device.** SDDM's default greeter is an X server, which on one
# vendor's driver presents through no plane at all; sddm-10-wayland.conf.example
# beside this file runs the greeter on KWin instead, which is captured like any
# session. Install it as /etc/sddm.conf.d/10-wayland.conf.
